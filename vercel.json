{
  "rewrites": [
    {
      "source": "/sitemap-products.xml",
      "destination": "https://arusuvaijunctionbackend.onrender.com/arusuvai/sitemap-products.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}